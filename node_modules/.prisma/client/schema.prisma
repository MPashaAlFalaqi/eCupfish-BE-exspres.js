generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN // Untuk Pembudidaya
  BUYER // Untuk Pembeli
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  phoneNumber String?
  password    String
  role        Role     @default(BUYER) // Default jika mendaftar biasa adalah pembeli
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
